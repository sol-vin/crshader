# Dual Kawase Bloom Blur Post-Processing
# Based on Garrett Gunnell (Acerola) Bloom Shaders
shader_type :canvas_item

render_mode :unshaded

uniform screen_texture : Sampler2D, hint: :screen_texture, filter: :linear_mipmap
uniform bloom_threshold : Float32 = 0.8, hint: hint_range(0.0, 2.0)
uniform bloom_intensity : Float32 = 1.5, hint: hint_range(0.0, 5.0)
uniform blur_radius : Float32 = 2.5, hint: hint_range(0.5, 10.0)

OFFSETS = [
  vec2(-1.0, -1.0),
  vec2( 1.0, -1.0),
  vec2(-1.0,  1.0),
  vec2( 1.0,  1.0)
]

def fragment
  uv = SCREEN_UV
  pixel_step = SCREEN_PIXEL_SIZE * blur_radius

  base_color = screen_texture.sample(uv).rgb

  # Multi-tap Kawase bloom blur
  bloom_sum = vec3(0.0, 0.0, 0.0)

  (0...4).each do |i|
    tap_uv = uv + OFFSETS[i] * pixel_step
    sample_col = screen_texture.sample_lod(tap_uv, 1.0).rgb

    # Bright-pass threshold curve
    brightness = max(sample_col.r, max(sample_col.g, sample_col.b))
    soft_factor = clamp(brightness - bloom_threshold, 0.0, 1.0)
    bloom_sum = bloom_sum + sample_col * soft_factor
  end

  bloom = (bloom_sum * 0.25) * bloom_intensity

  # Screen blend mode / additive tone combine
  final_rgb = base_color + bloom

  COLOR = vec4(final_rgb, 1.0)
end
