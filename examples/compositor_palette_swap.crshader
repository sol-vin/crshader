# =============================================================================
# Compositor Palette Swap - Direct Framebuffer Compute Pass
# =============================================================================
# Executes palette limiting directly on the engine's render buffer in GPU compute.

shader_type :compute
local_size 8, 8, 1

image2d color_image, set: 0, binding: 0, format: "rgba16f"

uniform original_palette = resource("res://default_palettes/cottonville.tres")
uniform target_palette = resource("res://default_palettes/vanitas.tres")
uniform dither_strength : Float32 = 0.0, hint: hint_range(0.0, 1.0, 0.01)

def main
  pos = ivec2(gl_GlobalInvocationID.xy)
  size = imageSize(color_image)
  if pos.x >= size.x || pos.y >= size.y
    return
  end

  curr_color = imageLoad(color_image, pos)

  best_idx = 0
  min_dist = 999999.0

  (0...original_palette.size).each do |i|
    orig = original_palette[i].rgb
    d = distance(curr_color.rgb, orig)
    if d < min_dist
      min_dist = d
      best_idx = i
    end
  end

  out_rgb = target_palette[best_idx].rgb
  imageStore(color_image, pos, vec4(out_rgb, curr_color.a))
end
