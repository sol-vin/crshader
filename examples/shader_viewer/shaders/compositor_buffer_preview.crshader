# =============================================================================
# Compositor Buffer Preview - Diagnostic Buffer Inspector Compute Pass
# =============================================================================
# Visualizes raw Reverse-Z depth, linearized depth, Forward+ normals, or luminance.

require "std/outline"

compositor_effect :post_transparent do
  access :color, :depth, :normal_roughness

  property preview_mode : Int32 = 0, hint: hint_range(0, 4)
  property z_near : Float32 = 0.05
  property z_far : Float32 = 100.0

  process_pixel do |pos, curr_color|
    depth_val = texelFetch(depth_texture, pos, 0).r

    if preview_mode == 1
      # Raw Reverse-Z Depth
      curr_color = vec4(depth_val, depth_val, depth_val, 1.0)
    elsif preview_mode == 2
      # Linearized Reverse-Z Depth Ramp
      lin = fast_linear_depth_reverse_z(depth_val, z_near, z_far)
      lin_norm = clamp(lin / z_far, 0.0, 1.0)
      curr_color = vec4(lin_norm, lin_norm, lin_norm, 1.0)
    elsif preview_mode == 3
      # Grayscale Luminance
      lum = 0.2126 * curr_color.r + 0.7152 * curr_color.g + 0.0722 * curr_color.b
      curr_color = vec4(lum, lum, lum, 1.0)
    elsif preview_mode == 4
      # Forward+ View-Space Normal
      n = unpack_view_normal(texelFetch(normal_roughness_texture, pos, 0).xyz) * 0.5 + vec3(0.5, 0.5, 0.5)
      curr_color = vec4(n, 1.0)
    end
  end
end
