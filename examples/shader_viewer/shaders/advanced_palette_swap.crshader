# =============================================================================
# Advanced Palette Swapping Tool with Variable-Sized Constant Arrays
# =============================================================================
# Highlights dynamically sized compile-time constant arrays.
# Exposes both palettes as editable shader parameter arrays in Godot while
# utilizing compile-time size constants for optimized loop iterations.

shader_type :canvas_item
render_mode :unshaded

uniform original_palette = [
  Color.new(0.05, 0.05, 0.05, 1.0),
  Color.new(0.30, 0.30, 0.30, 1.0),
  Color.new(0.65, 0.65, 0.65, 1.0),
  Color.new(0.95, 0.95, 0.95, 1.0)
]

uniform target_palette = [
  Color.new(0.10, 0.05, 0.20, 1.0),
  Color.new(0.40, 0.15, 0.45, 1.0),
  Color.new(0.85, 0.35, 0.40, 1.0),
  Color.new(1.00, 0.85, 0.50, 1.0)
]

uniform threshold : Float32 = 0.25, hint: hint_range(0.01, 1.0)

def fragment
  input_color = texture(TEXTURE, UV)

  best_idx = 0
  min_dist = 999.0

  (0...original_palette.size).each do |i|
    orig = original_palette[i]
    d = distance(input_color.rgb, orig.rgb)
    if d < min_dist
      min_dist = d
      best_idx = i
    end
  end

  if min_dist < threshold
    COLOR = vec4(target_palette[best_idx].rgb, input_color.a)
  else
    COLOR = input_color
  end
end
