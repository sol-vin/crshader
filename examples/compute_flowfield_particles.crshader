shader_type :compute

local_size 64, 1, 1

buffer ParticleData, set: 0, binding: 0, std: :std430, restrict: true do
  field positions : Array(Vec4)
  field velocities : Array(Vec4)
end

push_constant FlowParams do
  field delta_time : Float32
  field particle_count : UInt32
  field noise_scale : Float32
  field flow_speed : Float32
end

def main()
  idx = gl_GlobalInvocationID.x
  if idx >= flow_params.particle_count
    return
  end

  pos = particle_data.positions[idx].xyz
  vel = particle_data.velocities[idx].xyz

  p_scaled = pos * flow_params.noise_scale
  flow = vec3(sin(p_scaled.y + p_scaled.z), cos(p_scaled.z + p_scaled.x), sin(p_scaled.x + p_scaled.y))

  vel = mix(vel, flow * flow_params.flow_speed, 0.1)
  pos = pos + vel * flow_params.delta_time

  if length(pos) > 10.0
    pos = pos * 0.1
  end

  particle_data.positions[idx] = vec4(pos, 1.0)
  particle_data.velocities[idx] = vec4(vel, 0.0)
end
