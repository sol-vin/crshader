shader_type :spatial
render_mode :cull_disabled, :depth_draw_always

require "std/math"
require "std/noise"

group "Water Colors"
uniform shallow_color : Color = Color.new(0.2, 0.75, 0.85, 0.85), hint: :source_color
uniform deep_color : Color = Color.new(0.05, 0.15, 0.35, 0.95), hint: :source_color
uniform foam_color : Color = Color.new(0.9, 0.95, 1.0, 1.0), hint: :source_color

group "Waves & Motion"
uniform wave_speed : Float32 = 1.4, hint: range(0.1, 5.0, 0.1)
uniform wave_height : Float32 = 0.25, hint: range(0.0, 1.0, 0.05)
uniform wave_frequency : Float32 = 1.8, hint: range(0.5, 6.0, 0.1)

group "Caustics & Optics"
uniform caustics_scale : Float32 = 8.0, hint: range(1.0, 20.0, 0.5)
uniform caustics_speed : Float32 = 0.8, hint: range(0.1, 3.0, 0.1)
uniform roughness_val : Float32 = 0.15, hint: range(0.0, 1.0, 0.05)

varying v_world_pos : Vec3

def vertex
  v_world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz
  t = TIME * wave_speed
  
  wave1 = sin(v_world_pos.x * wave_frequency + t) * wave_height
  wave2 = cos(v_world_pos.z * wave_frequency * 0.8 + t * 1.2) * wave_height * 0.6
  
  VERTEX.y = VERTEX.y + wave1 + wave2
end

def fragment
  t_caustic = TIME * caustics_speed
  uv_c1 = v_world_pos.xz * caustics_scale * 0.1 + vec2(t_caustic * 0.1, t_caustic * 0.05)
  uv_c2 = v_world_pos.xz * caustics_scale * 0.15 - vec2(t_caustic * 0.08, -t_caustic * 0.12)
  
  c1 = voronoi(uv_c1)
  c2 = voronoi(uv_c2)
  caustic_val = min(c1, c2)
  caustic_intensity = smoothstep(0.4, 0.1, caustic_val) * 0.4
  
  view_dir = normalize(VIEW)
  fresnel_term = fresnel(4.0, NORMAL, view_dir)
  water_col = mix(deep_color.rgb, shallow_color.rgb, fresnel_term) + vec3(caustic_intensity, caustic_intensity, caustic_intensity)
  
  ALBEDO = water_col
  ROUGHNESS = roughness_val
  METALLIC = 0.1
  SPECULAR = 0.6
end
