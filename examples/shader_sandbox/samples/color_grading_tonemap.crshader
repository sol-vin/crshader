# Color Grading & ACES Filmic Tone Mapping Post-Processing
# Based on Garrett Gunnell (Acerola) Color Grading & Tonemapping
shader_type :canvas_item

render_mode :unshaded

uniform screen_texture : Sampler2D, hint: :screen_texture, filter: :linear
uniform exposure : Float32 = 1.0, hint: hint_range(0.1, 4.0)
uniform contrast : Float32 = 1.15, hint: hint_range(0.5, 2.0)
uniform saturation : Float32 = 1.1, hint: hint_range(0.0, 2.0)
uniform lift : Vec3 = vec3(0.0, 0.0, 0.0)
uniform gamma : Vec3 = vec3(1.0, 1.0, 1.0)
uniform gain : Vec3 = vec3(1.0, 1.0, 1.0)

# ACES Filmic Tone Mapping Curve (Krzysztof Narkowicz approximation)
def aces_film(x : Vec3) : Vec3
  a = 2.51
  b = 0.03
  c = 2.43
  d = 0.59
  e = 0.14
  clamp((x * (x * a + b)) / (x * (x * c + d) + e), 0.0, 1.0)
end

def fragment
  uv = SCREEN_UV
  raw_color = screen_texture.sample(uv).rgb

  # Exposure adjustment
  col = raw_color * exposure

  # Lift / Gamma / Gain color wheels
  col = gain * (col + lift * (vec3(1.0, 1.0, 1.0) - col))
  col = max(col, vec3(0.0, 0.0, 0.0))
  col = pow(col, vec3(1.0, 1.0, 1.0) / gamma)

  # ACES Filmic Tone Mapping
  col = aces_film(col)

  # Contrast around middle gray (0.18 linear / ~0.5 perceptual)
  col = (col - 0.5) * contrast + 0.5
  col = clamp(col, 0.0, 1.0)

  # Saturation
  lum = dot(col, vec3(0.2126, 0.7152, 0.0722))
  col = mix(vec3(lum, lum, lum), col, saturation)
  col = clamp(col, 0.0, 1.0)

  COLOR = vec4(col, 1.0)
end
