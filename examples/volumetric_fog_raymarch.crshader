shader_type :canvas_item
render_mode :unshaded

require "std/math"
require "std/atmosphere"

uniform screen_tex : Sampler2D, hint: :screen_texture, filter: :linear
uniform depth_tex : Sampler2D, hint: :depth_texture, filter: :nearest

group "Fog Properties"
uniform fog_density : Float32 = 0.04, hint: range(0.001, 0.2, 0.005)
uniform fog_color : Color = Color.new(0.65, 0.75, 0.9, 1.0), hint: :source_color
uniform sun_color : Color = Color.new(1.0, 0.85, 0.6, 1.0), hint: :source_color
uniform sun_direction : Vec3 = vec3(0.5, 0.6, -0.6)

group "Raymarching"
uniform ray_steps : Int32 = 24, hint: range(8, 64, 4)
uniform scattering_g : Float32 = 0.45, hint: range(-0.9, 0.9, 0.05)
uniform max_distance : Float32 = 40.0, hint: range(5.0, 100.0, 5.0)

def fragment
  scene_color = texture(screen_tex, SCREEN_UV)
  depth_val = texture(depth_tex, SCREEN_UV).x
  
  ray_dir = normalize(vec3((SCREEN_UV.x - 0.5) * 1.6, (0.5 - SCREEN_UV.y) * 1.2, -1.0))
  sun_dir = normalize(sun_direction)
  
  cos_theta = dot(ray_dir, sun_dir)
  phase = hg_phase(cos_theta, scattering_g)
  
  step_len = max_distance / float(ray_steps)
  accum_density = 0.0
  accum_light = vec3(0.0, 0.0, 0.0)
  
  (0..23).each do |i|
    dist = float(i) * step_len
    sample_density = fog_density * exp(-dist * 0.03)
    accum_density = accum_density + sample_density * step_len
    accum_light = accum_light + sun_color.rgb * phase * sample_density * step_len
  end
  
  transmittance = clamp(exp(-accum_density), 0.0, 1.0)
  final_rgb = scene_color.rgb * transmittance + (fog_color.rgb * (1.0 - transmittance) + accum_light)
  COLOR = vec4(final_rgb, 1.0)
end
